{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tally",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.tally.spending",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.tally.spending",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2F5FEA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tally uses Face ID to keep your spending private."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F5FEA",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "add": {
              "foregroundImage": "./assets/images/shortcut-add.png",
              "backgroundColor": "#2F5FEA"
            },
            "check": {
              "foregroundImage": "./assets/images/shortcut-check.png",
              "backgroundColor": "#16875A"
            },
            "recap": {
              "foregroundImage": "./assets/images/shortcut-recap.png",
              "backgroundColor": "#5B3FD0"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}